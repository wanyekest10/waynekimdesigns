---
// Case study cards: title and year on top, one-liner and skill label below.
const { items } = Astro.props;
---
<div class="cards">
  {items.map((w) => (
    <a class="card" href={`/work/${w.id}/`}>
      <img src={w.data.card ?? w.data.hero} alt={w.data.cardAlt ?? w.data.heroAlt} loading="lazy" class={w.data.cardFit === 'contain' ? 'contain' : undefined} />
      <div class="card-text">
        <span class="card-title">{w.data.title}</span>
        <span class="card-year">{w.data.year}</span>
      </div>
      <div class="card-text card-sub">
        <p class="card-line">{w.data.summary}</p>
        <span class="card-label">{w.data.label}</span>
      </div>
    </a>
  ))}
</div>
<style>
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 24px; }
  .card { color: var(--ink); text-decoration: none; display: block; min-width: 0; }
  .card:hover { text-decoration: none; }
  .card img { width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 6px; background: var(--panel); margin-bottom: 14px; transition: opacity .2s; }
  .card img.contain { object-fit: contain; }
  .card:hover img { opacity: .9; }
  .card:hover .card-title { color: var(--accent); }
  .card-text { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .card-title { font: var(--label); font-size: 16px; }
  .card-year { font: var(--meta); color: var(--gray); white-space: nowrap; }
  .card-label { font: var(--meta); color: var(--gray); white-space: nowrap; }
  .card-sub { margin-top: 4px; }
  .card-line { font: var(--small); font-size: 14px; color: var(--gray); min-width: 0; }
  @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } .card-sub { flex-direction: column; gap: 2px; } }
</style>
