---
// Case study cards: image (a short loop plays over it on hover, if there is one), then title and year, the one-liner, and the skill label.
const { items } = Astro.props;
---
<div class="cards">
  {items.map((w) => (
    <a class="card" href={`/${(w.data as any).listIn === 'experiments' ? 'play' : 'work'}/${w.id}/`}>
      <div class="card-img">
        <img src={w.data.card ?? w.data.hero} alt={w.data.cardAlt ?? w.data.heroAlt} loading="lazy" class={w.data.cardFit === 'contain' ? 'contain' : undefined} />
        {(w.data as any).cardVideo && <video class="card-vid" src={(w.data as any).cardVideo} muted loop playsinline preload="none" aria-hidden="true"></video>}
      </div>
      <div class="card-text">
        <span class="card-title">{w.data.title}</span>
        <span class="card-year">{w.data.year}</span>
      </div>
      <p class="card-line">{w.data.summary}</p>
      <p class="card-label">{w.data.label}</p>
    </a>
  ))}
</div>
<script>
  // Hover loops load and play only while hovered, and only where a mouse can hover.
  if (matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLAnchorElement>('.card').forEach((card) => {
      const v = card.querySelector<HTMLVideoElement>('.card-vid');
      if (!v) return;
      card.addEventListener('mouseenter', () => { v.play().then(() => card.classList.add('playing')).catch(() => {}); });
      card.addEventListener('mouseleave', () => { v.pause(); card.classList.remove('playing'); });
    });
  }
</script>
<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px 20px; }
  .card { color: var(--ink); text-decoration: none; display: block; min-width: 0; }
  .card:hover { text-decoration: none; }
  .card-img { position: relative; border-radius: 6px; overflow: hidden; margin-bottom: 12px; background: var(--panel); }
  .card img { display: block; width: 100%; aspect-ratio: 3/2; object-fit: cover; }
  .card img.contain { object-fit: contain; }
  .card:hover .card-title { color: var(--accent); }
  .card-text { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .card-title { font: var(--label); font-size: 16px; }
  .card-year { font: var(--meta); color: var(--gray); white-space: nowrap; }
  .card-label { font: var(--meta); color: var(--gray); margin-top: 5px; }
  .card-line { font: var(--small); font-size: 14px; line-height: 1.4; color: var(--gray); margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .25s ease; pointer-events: none; }
  .card.playing .card-vid { opacity: 1; }
  .card img { transition: opacity .2s; }
  .card:hover img { opacity: .92; }
  @media (max-width: 1000px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
</style>
