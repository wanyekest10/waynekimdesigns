---
// Case study cards: image (one-liner shows over it on hover), then title, year, and skill label.
const { items } = Astro.props;
---
<div class="cards">
  {items.map((w) => (
    <a class="card" href={`/${(w.data as any).listIn === 'experiments' ? 'play' : 'work'}/${w.id}/`}>
      <div class="card-img">
        <img src={w.data.card ?? w.data.hero} alt={w.data.cardAlt ?? w.data.heroAlt} loading="lazy" class={w.data.cardFit === 'contain' ? 'contain' : undefined} />
        <p class="card-over" aria-hidden="true">{w.data.summary}</p>
      </div>
      <div class="card-text">
        <span class="card-title">{w.data.title}</span>
        <span class="card-year">{w.data.year}</span>
      </div>
      <p class="card-label">{w.data.label}</p>
      <p class="card-line">{w.data.summary}</p>
    </a>
  ))}
</div>
<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px 20px; }
  .card { color: var(--ink); text-decoration: none; display: block; min-width: 0; }
  .card:hover { text-decoration: none; }
  .card-img { position: relative; border-radius: 6px; overflow: hidden; margin-bottom: 12px; background: var(--panel); }
  .card img { display: block; width: 100%; aspect-ratio: 3/2; object-fit: cover; }
  .card img.contain { object-fit: contain; }
  .card-over { position: absolute; inset: 0; display: flex; align-items: flex-end; margin: 0; padding: 16px;
    font-size: 15px; line-height: 1.35; color: #fff; background: linear-gradient(to top, rgba(14,14,14,.82), rgba(14,14,14,.15) 70%);
    opacity: 0; transition: opacity .2s ease; }
  .card:hover .card-over, .card:focus-visible .card-over { opacity: 1; }
  .card:hover .card-title { color: var(--accent); }
  .card-text { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .card-title { font: var(--label); font-size: 16px; }
  .card-year { font: var(--meta); color: var(--gray); white-space: nowrap; }
  .card-label { font: var(--meta); color: var(--gray); margin-top: 6px; }
  /* Touch screens have no hover: show the one-liner under the card instead */
  .card-line { display: none; font: var(--small); font-size: 14px; color: var(--gray); margin-top: 4px; }
  @media (hover: none) { .card-over { display: none; } .card-line { display: block; } }
  @media (max-width: 1000px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .card-over { transition: none; } }
</style>
