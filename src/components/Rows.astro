---
// Compact text rows: name, one line, year. Used for Experiments and the work archive.
// image: optional preview shown beside the row on hover (pointer devices only).
// preview: optional looping video used instead of the image; it loads and plays only while hovered.
interface Row { name: string; line?: string; tags?: string; year?: string; href?: string; image?: string; preview?: string; sub?: string; try?: string }
const { rows } = Astro.props as { rows: Row[] };
---
<ul class="rows">
  {rows.map((r) => (
    <li class:list={{ 'has-preview': r.image }}>
      {r.preview ? <video class="row-preview" src={r.preview} poster={r.image} muted loop playsinline preload="none" aria-hidden="true"></video>
        : r.image && <img class="row-preview" src={r.image} alt="" loading="lazy" aria-hidden="true" />}
      <span class="row-head">{r.href ? <a class="row-name" href={r.href}>{r.name}</a> : <span class="row-name">{r.name}</span>}{r.sub && <span class="row-sub">{r.sub}</span>}</span>
      <span class="row-line">{r.line ?? r.tags}{r.try && <> <a class="row-try" href={r.try}>Try it →</a></>}</span>
      <span class="row-year">{r.year}</span>
    </li>
  ))}
</ul>
<script>
  document.querySelectorAll('.rows li.has-preview').forEach((li) => {
    const v = li.querySelector('video.row-preview');
    if (!v) return;
    li.addEventListener('mouseenter', () => { v.play().catch(() => {}); });
    li.addEventListener('mouseleave', () => { v.pause(); });
  });
</script>
<style>
  .rows { list-style: none; border-bottom: 1px solid var(--rule); }
  .rows li { display: grid; grid-template-columns: 290px 1fr 64px; gap: 24px; padding: 12px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .row-name { font: var(--label); color: var(--ink); }
  .row-head { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .row-sub { font: var(--meta); color: var(--gray); }
  a.row-name { color: var(--accent); }
  .row-line { color: var(--gray); font-size: 15px; }
  .row-try { color: var(--accent); white-space: nowrap; }
  .row-year { font: var(--meta); color: var(--gray); text-align: right; white-space: nowrap; }
  .rows li { position: relative; }
  .row-preview { display: none; }
  @media (hover: hover) and (min-width: 721px) {
    .row-preview { display: block; position: absolute; right: 72px; top: 50%; width: 220px; border-radius: 4px;
      box-shadow: 0 8px 24px rgba(20, 20, 20, 0.12); pointer-events: none; z-index: 2;
      opacity: 0; transform: translateY(-46%); transition: opacity 0.18s ease, transform 0.18s ease; }
    .rows li.has-preview:hover .row-preview { opacity: 1; transform: translateY(-50%); }
  }
  @media (prefers-reduced-motion: reduce) { .row-preview { transition: none; } }
  @media (max-width: 720px) {
    .rows li { grid-template-columns: 1fr auto; gap: 2px 16px; }
    .row-line { grid-column: 1; grid-row: 2; }
    .row-year { grid-column: 2; grid-row: 1; }
  }
</style>
