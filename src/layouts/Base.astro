---
import '../styles/global.css';
import CopyEmail from '../components/CopyEmail.astro';
interface Props { title: string; description?: string; wide?: boolean; noindex?: boolean; prompt?: string | false; cta?: string }
const { title, wide = false, noindex = false, prompt = 'Have something you\'re working on?', cta = 'Send me a message →', description = 'Wayne Kim builds prototypes and tests them with real people. Researcher and interaction designer in Los Angeles.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wayne laughing and reaching up to Linee, a wall-mounted timekeeper, with two teammates" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class:list={["wrap", { wide }]}>
      <nav class="nav" aria-label="Main">
        <a class="home" href="/" aria-label="Wayne Kim, home">Wayne <span class="kimswap" aria-hidden="true"><svg class="kmark" viewBox="0 0 100 100"><path class="kp giyeok" d="M14 14 H50 V46"/><path class="kp i" d="M72 8 V52"/><rect class="kp mieum" x="18" y="64" width="58" height="28"/></svg><span class="kword"><span>K</span><span>i</span><span>m</span></span></span></a>
        <ul>
          <li><a href="/work/">Work</a></li>
          <li><a href="/play/">Play</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/collaborate/">Collaborate</a></li>
        </ul>
      </nav>
      <slot />
      {prompt && (
        <aside class="closing"><p>{prompt}</p><a href="/collaborate/#message">{cta}</a></aside>
      )}
      <footer class="footer">
        <span>Say hello: <CopyEmail /></span>
        <span class="links"><span>Based in Los Angeles</span> <a href="https://www.linkedin.com/in/waynewkim/">LinkedIn</a> <a href="/resume.pdf">Resume</a></span>
      </footer>
    </div>
    <script>
      // Wayne 김: the three pieces click together on the first page of a visit; on a mouse hover they give way to "Kim".
      (() => {
        const home = document.querySelector('.nav .home'); const box = home?.querySelector('.kimswap');
        if (!home || !box) return;
        const mark = box.querySelector('.kmark'), word = box.querySelector('.kword');
        const fit = () => { box.style.width = (box.classList.contains('on') ? word.scrollWidth : mark.getBoundingClientRect().width) + 'px'; };
        fit(); document.fonts?.ready.then(fit);
        let seen = false; try { seen = sessionStorage.getItem('kim-seen') === '1'; sessionStorage.setItem('kim-seen', '1'); } catch (e) {}
        if (!seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          box.classList.add('apart'); requestAnimationFrame(() => requestAnimationFrame(() => setTimeout(() => box.classList.remove('apart'), 200)));
        }
        const set = (on) => { box.classList.toggle('on', on); fit(); };
        home.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') set(true); });
        home.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') set(false); });
        home.addEventListener('focus', () => set(true)); home.addEventListener('blur', () => set(false));
      })();
      document.querySelectorAll('.copy-email').forEach((a) => {
        let t;
        a.addEventListener('click', async (e) => {
          if (!navigator.clipboard) return; // falls back to opening email
          e.preventDefault();
          try { await navigator.clipboard.writeText(a.dataset.email); }
          catch { window.location.href = a.href; return; }
          a.classList.add('is-copied');
          const s = a.nextElementSibling; if (s) s.textContent = 'Email copied';
          clearTimeout(t);
          t = setTimeout(() => { a.classList.remove('is-copied'); if (s) s.textContent = ''; }, 2000);
        });
      });
    </script>
    <script>
      const nav = document.querySelector('.nav');
      const onScroll = () => nav && nav.classList.toggle('scrolled', window.scrollY > 8);
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    </script>
    <script>
      const live = document.querySelectorAll('.vimeo-live');
      if (live.length) {
        const s = document.createElement('script');
        s.src = 'https://player.vimeo.com/api/player.js';
        s.onload = () => live.forEach((f) => {
          const player = new (window as any).Vimeo.Player(f.querySelector('iframe'));
          const btn = f.querySelector('.vl-sound') as HTMLButtonElement;
          btn.addEventListener('click', async () => {
            const on = btn.getAttribute('aria-pressed') !== 'true';
            await player.setMuted(!on);
            if (on) await player.setVolume(1);
            btn.setAttribute('aria-pressed', String(on));
            btn.textContent = on ? 'Sound on' : 'Sound off';
          });
        });
        document.head.appendChild(s);
      }
    </script>
  </body>
</html>
