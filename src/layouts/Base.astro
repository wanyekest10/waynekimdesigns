---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Wayne Kim builds prototypes and tests them with real people. Researcher and interaction designer in Los Angeles.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="wrap">
      <nav class="nav" aria-label="Main">
        <a class="home" href="/">Wayne Kim</a>
        <ul>
          <li><a href="/work/">Work</a></li>
          <li><a href="/play/">Play</a></li>
          <li><a href="/#about">About</a></li>
        </ul>
      </nav>
      <slot />
      <footer class="footer">
        <span>Say hello: <a class="copy-email" href="mailto:waynekimdesigns@gmail.com" data-email="waynekimdesigns@gmail.com" aria-label="Copy email address waynekimdesigns@gmail.com"><svg class="ic ic-copy" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="9" height="9" rx="2" fill="currentColor"/><path d="M3.5 10.5h-.5a1.5 1.5 0 0 1-1.5-1.5V3a1.5 1.5 0 0 1 1.5-1.5h6A1.5 1.5 0 0 1 10.5 3v.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><svg class="ic ic-done" viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="5.5" width="9" height="9" rx="2" fill="currentColor"/><path d="M5.5 3.5V3A1.5 1.5 0 0 1 7 1.5h6A1.5 1.5 0 0 1 14.5 3v6a1.5 1.5 0 0 1-1.5 1.5h-.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.6 10.2l1.6 1.6 3.2-3.4" fill="none" stroke="var(--paper)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="addr">waynekimdesigns@gmail.com</span></a><span class="copied" role="status" aria-live="polite"></span></span>
        <span class="links"><a href="https://www.linkedin.com/in/waynewkim/">LinkedIn</a> <a href="/resume.pdf">Resume</a></span>
      </footer>
    </div>
    <script>
      document.querySelectorAll('.copy-email').forEach((a) => {
        let t;
        a.addEventListener('click', async (e) => {
          if (!navigator.clipboard) return; // falls back to opening email
          e.preventDefault();
          try { await navigator.clipboard.writeText(a.dataset.email); }
          catch { window.location.href = a.href; return; }
          a.classList.add('is-copied');
          const s = a.nextElementSibling; if (s) s.textContent = 'Email copied';
          clearTimeout(t);
          t = setTimeout(() => { a.classList.remove('is-copied'); if (s) s.textContent = ''; }, 2000);
        });
      });
    </script>
  </body>
</html>
