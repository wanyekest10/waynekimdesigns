---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';

const ways = [
  {
    q: 'Should we build this?',
    a: "I turn the doubt into one question we can test, put a quick prototype in front of real people, and watch what they do, not what they say. You get a decision with evidence behind it.",
    ex: 'At Glorify, leadership doubted community would work. A two-week prototype study with 82 people in their real groups gave them the confidence to launch Glorify Groups, now used by 1.8M+ people.',
    proof: [ { name: 'Glorify Groups', href: '/work/glorify-groups/' }, { name: 'RaiseMe Portal', href: '/work/raiseme-portal/' } ],
  },
  {
    q: 'Will it actually work?',
    a: "When the idea involves hardware, a camera, or AI, slides won't settle it. I build a working version, the code, the electronics, and the thing you hold, and test it where it would actually live. You find out what breaks while it's still cheap to change.",
    ex: 'For Living.fm, I trained a camera to recognize what people were doing at home and tested an AI radio host live. The most important lesson, knowing when to stay quiet, only showed up once people lived with it.',
    proof: [ { name: 'Living.fm', href: '/work/living-fm/' }, { name: 'room_tone', href: '/work/room-tone/' }, { name: 'Toilet Paper Elevator', href: '/work/toilet-paper-elevator/' }, { name: 'Linee', href: '/work/linee/' } ],
  },
  {
    q: 'How do we get everyone on the same page?',
    a: "I run a workshop where everyone writes down their position before anyone talks, so the loudest voice doesn't win by default. Then I turn the wall into a plan someone can act on.",
    ex: 'At Glorify, leaders from four teams did exactly this, and the wall became the research agenda for the year.',
    proof: [ { name: 'Facilitation', href: '/work/facilitation/' } ],
  },
];

const steps = [
  'Email me a few lines about what you are working on. It doesn\'t need to be polished.',
  'We talk for 30 minutes about where you are and what is in the way.',
  'If it\'s a fit, I send a short proposal with scope and timeline.',
];
---
<Base title="How I can help, Wayne Kim" description="Should we build this? Will it actually work? How do we get everyone on the same page? How Wayne Kim helps teams answer all three.">
  <header class="top">
    <p class="status"><span class="dot" aria-hidden="true"></span>Open to full-time and contract roles</p>
    <h1>How I can help</h1>
    <p class="lead">I'm most useful when a team needs to understand a problem and build something to test it. Most researchers don't build, and most prototypers don't research. I do both.</p>
  </header>

  <ol class="ways">
    {ways.map((w, i) => (
      <li id={`way-${i + 1}`}>
        <h2>{w.q}</h2>
        <div class="body">
          <p class="ans">{w.a}</p>
          <p class="ex"><span class="ex-tag">For example</span>{w.ex}</p>
          <p class="proof">{w.proof.map((p) => <a href={p.href}>{p.name} →</a>)}</p>
        </div>
      </li>
    ))}
  </ol>

  <section class="start">
    <h2 class="section-title">How it starts</h2>
    <ol class="steps">
      {steps.map((s) => <li>{s}</li>)}
    </ol>
    <p class="cta">
      <span class="big"><CopyEmail /></span>
      <span>Hiring full-time? Here's my <a href="/resume.pdf">resume</a>.</span>
    </p>
  </section>
</Base>

<style>
  .top { max-width: var(--measure); margin-bottom: 72px; }
  .status { display: inline-flex; align-items: center; gap: 8px; font: var(--meta); letter-spacing: -0.02em; color: var(--gray); margin-bottom: 20px; }
  .dot { margin-left: 3px; width: 7px; height: 7px; border-radius: 50%; background: #1E9E5A; box-shadow: 0 0 0 3px rgba(30,158,90,.15); }
  .lead { color: var(--gray); }

  .ways { list-style: none; margin-bottom: 96px; }
  .ways > li { scroll-margin-top: 72px; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 16px 48px; padding: 40px 0; border-top: 1px solid var(--rule); }
  .ways > li:last-child { border-bottom: 1px solid var(--rule); }
  .ways h2 { font: var(--h2); font-size: 26px; line-height: 1.25; letter-spacing: -0.02em; }
  .ans { color: var(--ink); margin-bottom: 16px; }
  .ex { color: var(--gray); font-size: 15px; padding-left: 16px; border-left: 2px solid var(--rule); margin-bottom: 16px; }
  .ex-tag { display: block; font: var(--meta); letter-spacing: -0.02em; text-transform: uppercase; margin-bottom: 4px; }
  .proof { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 15px; }

  .start { max-width: var(--measure); }
  .steps { counter-reset: s; list-style: none; margin-bottom: 40px; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 32px 1fr; padding: 10px 0; color: var(--gray); }
  .steps li::before { content: counter(s); font: var(--meta); color: var(--gray); padding-top: 4px; }
  .cta { display: flex; flex-direction: column; gap: 8px; }
  .cta .big { font: var(--h2); letter-spacing: -0.01em; }
  .cta span { color: var(--gray); font-size: 15px; }

  @media (max-width: 720px) {
    .ways > li { grid-template-columns: 1fr; padding: 32px 0; }
    .ways h2 { font-size: 22px; }
  }
</style>
