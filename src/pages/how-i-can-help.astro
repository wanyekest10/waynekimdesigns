---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';

const ways = [
  {
    title: 'Should we build this?',
    when: "You're about to commit to a bet, and you're not sure it's the right one.",
    what: "I turn the doubt into one question we can test, then pick the method that fits. Interviews, surveys, and a service blueprint to understand how things work today. A quick prototype in front of the people who would use it to see what they actually do.",
    get: 'A decision, with evidence behind it, from someone who has spent ten years in design research.',
    proof: [ { name: 'Glorify Groups', href: '/work/glorify-groups/' }, { name: 'RaiseMe Portal', href: '/work/raiseme-portal/' } ],
  },
  {
    title: 'Will it actually work?',
    when: "The idea involves sensors, a camera, hardware, a digital experience, or AI, and slides won't settle it.",
    what: 'I build a working prototype, from the code and electronics to the thing you hold, and test it where it would actually live.',
    get: 'Something people can use, and what we learned from watching them use it.',
    proof: [ { name: 'Living.fm', href: '/work/living-fm/' }, { name: 'room_tone', href: '/work/room-tone/' }, { name: 'Toilet Paper Elevator', href: '/work/toilet-paper-elevator/' }, { name: 'Linee', href: '/work/linee/' } ],
  },
  {
    title: 'How do we get everyone on the same page?',
    when: "Your team has strong opinions about what's next, and they haven't been tested against each other. Or the ideas on the table all feel safe.",
    what: 'I design and run workshops that do two things. Open up: creative exercises and playful constraints that get a room past its first, safe ideas. Then narrow down: everyone writes their position before anyone talks, so the loudest voice doesn\'t win by default. I synthesize the wall into themes.',
    get: 'Fresh ideas worth testing, and a plan someone can act on.',
    proof: [ { name: 'Facilitation', href: '/work/facilitation/' } ],
  },
];

const steps = [
  'Email me a few lines about what you are working on. It doesn\'t need to be polished.',
  'We talk for 30 minutes about where you are and what is in the way.',
  'If it\'s a fit, I send a short proposal with scope and timeline.',
];
---
<Base title="How I can help, Wayne Kim" description="How Wayne Kim can help: testing a bet before you build it, prototyping hardware and AI ideas, and running workshops that end in a plan.">
  <header class="top">
    <p class="status"><span class="dot" aria-hidden="true"></span>Open to full-time and contract roles</p>
    <h1>How I can help</h1>
    <p class="lead">I'm most useful when a team needs to understand a problem and build something to test it. Most researchers don't build, and most prototypers don't research. I do both.</p>
  </header>

  <div class="ways">
    {ways.map((w, i) => (
      <section class="way" id={`way-${i + 1}`}>
        <h2>{w.title}</h2>
        <p class="w-when">{w.when}</p>
        <p class="w-what">{w.what}</p>
        <p class="w-get"><b>You get</b> {w.get}</p>
        <p class="proof">{w.proof.map((p) => <a href={p.href}>{p.name}</a>)}</p>
      </section>
    ))}
  </div>

  <section class="start">
    <h2 class="section-title">How it starts</h2>
    <ol class="steps">
      {steps.map((s) => <li>{s}</li>)}
    </ol>
    <p class="cta">
      <span class="big"><CopyEmail /></span>
      <span>Hiring full-time? Here's my <a href="/resume.pdf">resume</a>.</span>
    </p>
  </section>
</Base>

<style>
  .top { max-width: var(--measure); margin-bottom: 72px; }
  .status { display: inline-flex; align-items: center; gap: 8px; font: var(--meta); letter-spacing: -0.02em; color: var(--gray); margin-bottom: 20px; }
  .dot { margin-left: 3px; width: 7px; height: 7px; border-radius: 50%; background: #1E9E5A; box-shadow: 0 0 0 3px rgba(30,158,90,.15); }
  .lead { color: var(--gray); }

  .ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 96px; }
  .way { scroll-margin-top: 72px; background: var(--panel); border-radius: 10px; padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .way h2 { font: var(--h2); font-size: 20px; line-height: 1.3; letter-spacing: -0.01em; min-height: 2.6em; }
  .w-when { color: var(--gray); font-size: 15px; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
  .w-what { font-size: 15px; }
  .w-get { font-size: 15px; color: var(--gray); }
  .w-get b { color: var(--ink); font-weight: 500; }
  .proof { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 15px; margin-top: auto; padding-top: 8px; }
  @media (max-width: 860px) { .ways { grid-template-columns: 1fr; } .way h2 { min-height: 0; } }

  .start { max-width: var(--measure); }
  .steps { counter-reset: s; list-style: none; margin-bottom: 40px; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 32px 1fr; padding: 10px 0; color: var(--gray); }
  .steps li::before { content: counter(s); font: var(--meta); color: var(--gray); padding-top: 4px; }
  .cta { display: flex; flex-direction: column; gap: 8px; }
  .cta .big { font: var(--h2); letter-spacing: -0.01em; }
  .cta span { color: var(--gray); font-size: 15px; }

</style>
