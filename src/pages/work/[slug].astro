---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((w) => ({ params: { slug: w.id }, props: { w } }));
}
const { w } = Astro.props;
const { Content } = await render(w);
---
<Base title={`${w.data.title}, Wayne Kim`} description={w.data.summary}>
  <div class="meta">{w.data.context}</div>
  <h1>{w.data.title}</h1>
  <p class="lead">{w.data.headline}</p>
  <img class="hero" src={w.data.hero} alt={w.data.heroAlt} />
  <p class="jump"><a href="#full">Read the full case study ↓</a></p>
  <article><Content /></article>
  <p class="back"><a href="/#work">← All work</a></p>
</Base>
<style>.back { margin-top: 64px; } .hero { margin-bottom: 20px; } .jump { margin: 0 0 56px; }</style>
