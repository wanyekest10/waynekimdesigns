---
import CaseStudy from '../../components/CaseStudy.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const work = (await getCollection('work')).filter((w) => (w.data as any).listIn !== 'experiments');
  return work.map((w) => ({ params: { slug: w.id }, props: { w } }));
}
const { w } = Astro.props;
---
<CaseStudy w={w} />
