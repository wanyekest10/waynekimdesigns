---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Rows from '../../components/Rows.astro';
import { archive } from '../../data/archive';
const work = (await getCollection('work')).filter((w) => (w.data as any).listIn !== 'experiments').sort((a, b) => a.data.order - b.data.order);
// Work done inside companies (on staff, or for Designit's clients), shown as its own group.
const INDUSTRY = ['glorify-groups', 'raiseme-portal', 'designit-futures', 'facilitation'];
const row = (w: any) => ({ name: w.data.title, sub: w.data.label, line: w.data.summary, year: String(w.data.year), href: `/work/${w.id}/`, image: w.data.card ?? w.data.hero });
const independent = work.filter((w) => !INDUSTRY.includes(w.id)).map(row);
const industry = INDUSTRY.map((id) => work.find((w) => w.id === id)).filter(Boolean).map(row);
---
<Base title="Work, Wayne Kim" description="Case studies and projects by Wayne Kim, researcher and interaction designer.">
  <h1>Work</h1>
  <p class="lead">Case studies in prototyping and research.</p>
  <section class="block">
    <div class="block-head">
      <h2 class="section-title">Independent and CIID</h2>
      <span class="block-sub">Prototypes I built on my own and at CIID.</span>
    </div>
    <Rows rows={independent} />
  </section>
  <section class="block">
    <div class="block-head">
      <h2 class="section-title">Industry work</h2>
      <span class="block-sub">On staff at Glorify and RaiseMe, and with clients at Designit.</span>
    </div>
    <Rows rows={industry} />
  </section>
  {archive.length > 0 && (
  <section class="block">
    <div class="block-head">
      <h2 class="section-title">More projects</h2>
      <span class="block-sub">Write-ups coming.</span>
    </div>
    <Rows rows={archive} />
  </section>
  )}
</Base>
<style>
  .lead { margin-bottom: 64px; }
  .block { margin-bottom: 96px; }
  .block-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin-bottom: 20px; }
  .block-head .section-title { margin-bottom: 0; }
  .block-sub { color: var(--gray); font-size: 15px; }
</style>
