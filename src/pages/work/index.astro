---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Rows from '../../components/Rows.astro';
import { archive } from '../../data/archive';
const all = await getCollection('work');
const work = all.filter((w) => (w.data as any).listIn !== 'experiments').sort((a, b) => a.data.order - b.data.order);
// How far each project got.
const STATUS: Record<string, string> = {
  'living-fm': 'Prototype', 'toilet-paper-elevator': 'Prototype', 'room-tone': 'Prototype', 'disco-never-died': 'Performed live',
  'linee': 'Prototype', 'bureau-of-sanctioned-sketching': 'Playtested', 'lume': 'Prototype',
  'glorify-groups': 'Shipped', 'raiseme-portal': 'Shipped', 'designit-futures': 'Shipped', 'facilitation': 'Delivered', 'mirrored-canvas': 'Prototype',
};
const row = (w: any) => ({ status: STATUS[w.id], name: w.data.title, sub: w.data.label, line: w.data.summary, year: String(w.data.year), href: `/${(w.data as any).listIn === 'experiments' ? 'play' : 'work'}/${w.id}/`, image: w.data.card ?? w.data.hero });
// Grouped by the kind of work, so each team finds theirs first. Shipped work sits next to prototypes.
const GROUPS = [
  { title: 'Physical products', sub: 'Objects and spaces, built with electronics and fabrication.', ids: ['toilet-paper-elevator', 'room-tone', 'linee', 'lume'] },
  { title: 'AI and software', sub: 'Apps and AI, from prototypes to shipped products.', ids: ['living-fm', 'glorify-groups', 'raiseme-portal'] },
  { title: 'Play and games', sub: 'Games and performances that get people playing.', ids: ['bureau-of-sanctioned-sketching', 'disco-never-died', 'mirrored-canvas'] },
  { title: 'Strategy and facilitation', sub: 'Helping teams decide what to make.', ids: ['designit-futures', 'facilitation'] },
].map((g) => ({ ...g, rows: g.ids.map((id) => all.find((w) => w.id === id)).filter(Boolean).map(row) }));
---
<Base title="Work, Wayne Kim" description="Case studies and projects by Wayne Kim, researcher and interaction designer.">
  <h1>Work</h1>
  <p class="lead">From first prototype to shipped product.</p>
  {GROUPS.map((g) => (
  <section class="block">
    <div class="block-head">
      <h2 class="section-title">{g.title}</h2>
      <span class="block-sub">{g.sub}</span>
    </div>
    <Rows rows={g.rows} />
  </section>
  ))}
  {archive.length > 0 && (
  <section class="block">
    <div class="block-head">
      <h2 class="section-title">More projects</h2>
      <span class="block-sub">Write-ups coming.</span>
    </div>
    <Rows rows={archive} />
  </section>
  )}
</Base>
<style>
  .lead { margin-bottom: 64px; }
  .block { margin-bottom: 96px; }
  .block-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin-bottom: 20px; }
  .block-head .section-title { margin-bottom: 0; }
  .block-sub { color: var(--gray); font-size: 15px; }
  @media (max-width: 720px) { .block { margin-bottom: 64px; } .block-head { margin-bottom: 12px; } }
</style>
