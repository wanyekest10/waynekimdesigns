---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Cards from '../components/Cards.astro';
import Rows from '../components/Rows.astro';
import { experiments } from '../data/experiments';
const work = (await getCollection('work')).filter((w) => w.data.featured).sort((a, b) => a.data.order - b.data.order);

const years = [
  { when: "'25–now", what: 'Interaction designer, independent', note: 'Building physical and AI prototypes, like <a href="/work/room-tone/">room_tone</a> and <a href="/work/toilet-paper-elevator/">Toilet Paper Elevator</a>.' },
  { when: "'24–'25", what: 'Interaction Design, CIID', peek: [
    { src: '/about/ciid-class.webp', alt: 'The CIID class with staff and faculty on the grass, in orange scarves, looking up at the camera', caption: "CIID '24 with staff + faculty at Impact Minds" },
    { src: '/about/ciid-graduation.webp', alt: 'The class in flower crowns, holding up their certificates', caption: 'Graduation day' },
    { src: '/about/ciid-impact-minds.webp', alt: 'A large group photo on a grassy hillside, everyone looking up and waving at the camera', caption: 'Everyone at Impact Minds' },
  ], note: 'M.S. A year of research, build, test, repeat, prototyping across mediums.' },
  { when: "'23–'24", what: 'Senior UX Researcher, Glorify', note: 'Built the research practice and led 3 researchers. Shaped Glorify Groups (1.8M+ users).' },
  { when: "'21–'23", what: 'Design Researcher, Designit', note: 'Led research for Fortune 500 clients like Mastercard and Trane, plus <a href="/work/designit-futures/">speculative futures work</a>.' },
  { when: "'20–'21", what: 'Independent designer and researcher', note: 'Projects for Y Combinator companies like Govly, Rally.Video, and Measured.' },
  { when: "'17–'20", what: 'UX Strategist, RaiseMe', note: 'Research and strategy for a B2B2C edtech company.' },
  { when: "'15–'17", what: 'Assistant Dean of Admission, Reed College', note: 'Designed the <a href="https://www.reed.edu/admission-aid/visit/multicultural-programs/junior-scholars.html">Junior Scholars program</a> from 0 to 1 and ran the Senior Scholars program.' },
  { when: "'10–'14", what: 'B.A. Sociology, Colby College', note: '' },
];
---
<Base title="Wayne Kim, researcher who builds">
  <header class="intro">
    <h1>Wayne Kim</h1>
    <p class="lead">Interaction designer and researcher</p>
    <p class="status"><span class="dot" aria-hidden="true"></span>Open to full-time and contract roles</p>
  </header>

  <section id="work" class="block">
    <h2 class="section-title">Selected work</h2>
    <Cards items={work} />
    <p class="more"><a href="/work/">See all work →</a></p>
  </section>

  <section id="experiments" class="block">
    <div class="block-head">
      <h2 class="section-title">Experiments</h2>
      <span class="block-sub">Shorter projects and things I was curious about.</span>
    </div>
    <Rows rows={experiments} />
    <p class="more"><a href="/experiments/">See all experiments →</a></p>
  </section>

  <section id="about" class="block">
    <h2 class="section-title">About</h2>
    <div class="about">
      <p>I'm an interaction designer and researcher. I start by understanding the context, then build a prototype with a question in mind, put it in front of people, learn, and repeat.</p>
      <p>I spent ten years in design research, at startups backed by a16z, YC, and SoftBank and at the design firm Designit, where I led research for Fortune 500 clients. Then I spent a year studying interaction design at CIID, where I started building with computer vision, AI, spatial computing, code, and electronics. That closed the loop: I could understand a context, build something, test it, and do it again.</p>
      <p>Lately I'm drawn to calm technology, ambient interaction, and making invisible systems visible: things that notice instead of nag.</p>
    </div>
    <ul class="years">
      {years.map((y) => (
        <li><span class="when">{y.when}</span><span>{y.peek ? (
          <span class="peek" tabindex="0"><strong>{y.what}</strong><span class="peek-card" role="tooltip"><span class="peek-stack">{y.peek.map((p: any, i: number) => <img class:list={{ on: i === 0 }} src={p.src} alt={p.alt} loading="lazy" />)}</span>{y.peek.map((p: any, i: number) => <span class:list={['peek-cap', { on: i === 0 }]}>{p.caption}</span>)}<span class="peek-dots" aria-hidden="true">{y.peek.map((_: any, i: number) => <i class:list={{ on: i === 0 }}></i>)}</span></span></span>
        ) : <strong>{y.what}</strong>}{y.note && <span class="note" set:html={y.note} />}</span></li>
      ))}
    </ul>
  </section>
  <script>
    document.querySelectorAll('.peek').forEach((peek) => {
      const groups = ['.peek-stack img', '.peek-cap', '.peek-dots i'].map((q) => Array.from(peek.querySelectorAll(q)));
      const n = groups[0].length; if (n < 2) return;
      let i = 0, t: ReturnType<typeof setInterval> | undefined;
      const show = (k: number) => { i = k; groups.forEach((g) => g.forEach((el, j) => el.classList.toggle('on', j === k))); };
      const start = () => { if (t) return; t = setInterval(() => show((i + 1) % n), 1800); };
      const stop = () => { clearInterval(t); t = undefined; show(0); };
      peek.addEventListener('mouseenter', start); peek.addEventListener('mouseleave', stop);
      peek.addEventListener('focus', start); peek.addEventListener('blur', stop);
    });
  </script>
</Base>

<style>
  .intro { margin-bottom: 120px; }
  .status { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font: var(--meta); letter-spacing: -0.02em; color: var(--gray); margin-top: 20px; }
  .dot { margin-left: 3px; width: 7px; height: 7px; border-radius: 50%; background: #1E9E5A; box-shadow: 0 0 0 3px rgba(30,158,90,.15); }
  .intro h1 { font-size: 32px; letter-spacing: -0.03em; margin-bottom: 12px; }
  .intro .lead { color: var(--gray); }
  .sub { color: var(--gray); max-width: 36em; }
  .block { margin-bottom: 120px; scroll-margin-top: 24px; }
  .years { list-style: none; max-width: 760px; }
  .more { margin-top: 24px; text-align: right; font-size: 15px; }
  .block-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin-bottom: 20px; }
  .block-head .section-title { margin-bottom: 0; }
  .block-sub { color: var(--gray); font-size: 15px; }
  .about { max-width: var(--measure); margin-bottom: 40px; }
  .about p { color: var(--gray); margin-bottom: 16px; }
  .years li { display: grid; grid-template-columns: 80px 1fr; gap: 24px; padding: 12px 0; border-top: 1px solid var(--rule); }
  .when { font: var(--meta); color: var(--gray); padding-top: 3px; }
  .years strong { font: var(--label); display: block; }
  .peek { position: relative; display: inline-block; cursor: default; outline: none; }
  .peek strong { text-decoration: underline dotted var(--gray); text-underline-offset: 4px; }
  .peek-card { position: absolute; left: calc(100% + 20px); top: 50%; width: 460px; padding: 8px; background: var(--paper); border: 1px solid var(--rule); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.08); opacity: 0; transform: translate(-4px, -50%); pointer-events: none; transition: opacity .15s, transform .15s; z-index: 10; }
  .peek-stack { position: relative; display: block; aspect-ratio: 3/2; }
  .peek-stack img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 4px; opacity: 0; transition: opacity .4s; }
  .peek-stack img.on { opacity: 1; }
  .peek-cap { display: none; font: var(--small); color: var(--gray); margin-top: 6px; }
  .peek-cap.on { display: block; }
  .peek-dots { display: flex; gap: 4px; margin-top: 6px; }
  .peek-dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--rule); }
  .peek-dots i.on { background: var(--ink); }
  .peek:hover .peek-card, .peek:focus .peek-card, .peek:focus-within .peek-card { opacity: 1; transform: translate(0, -50%); }
  @media (max-width: 720px) { .peek-card { display: none; width: calc(100vw - 32px); max-width: 420px; left: -104px; top: auto; bottom: calc(100% + 10px); transform: none; } .peek:hover .peek-card, .peek:focus .peek-card, .peek:focus-within .peek-card { display: block; transform: none; } }
  .note { display: block; color: var(--gray); font-size: 15px; }
  @media (max-width: 720px) {
    .intro, .block { margin-bottom: 80px; }
  }
</style>
