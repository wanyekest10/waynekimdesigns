---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Cards from '../components/Cards.astro';
import Rows from '../components/Rows.astro';
import { play } from '../data/play';
const work = (await getCollection('work')).filter((w) => w.data.featured).sort((a, b) => a.data.order - b.data.order);

const years = [
  { when: "'24–'25", what: 'Interaction Design, CIID', note: 'M.S. One year of research, build, test, repeat.' },
  { when: "'23–'24", what: 'Senior UX Researcher, Glorify', note: 'Research behind Glorify Groups, now 1.8M+ users.' },
  { when: "'21–'23", what: 'Design Researcher, Designit', note: 'Led research for Fortune 500 clients like Mastercard and Trane, plus <a href="https://www.designit.com/stories/point-of-view/future-of-agriculture">speculative futures work</a>.' },
  { when: "'17–'20", what: 'UX Strategist, RaiseMe', note: 'Research and strategy for a college partner portal.' },
  { when: 'Before', what: 'Assistant Dean of Admission, Reed College', note: 'Designed the Junior Scholars program.' },
  { when: "'10–'14", what: 'B.A. Sociology, Colby College', note: '' },
];
---
<Base title="Wayne Kim, researcher who builds">
  <header class="intro">
    <p class="status"><span class="dot" aria-hidden="true"></span>Open to full-time and contract roles</p>
    <h1 class="hero-name">Wayne Kim</h1>
    <p class="lead">Interaction designer and researcher.</p>
  </header>

  <section id="work" class="block">
    <h2 class="section-title">Selected work</h2>
    <Cards items={work} />
    <p class="more"><a href="/work/">All work →</a></p>
  </section>

  <section id="play" class="block">
    <div class="block-head">
      <h2 class="section-title">Play</h2>
      <span class="block-sub">Small builds, gifts, and explorations.</span>
    </div>
    <Rows rows={play.slice(0, 3)} />
    <p class="more"><a href="/play/">See all play →</a></p>
  </section>

  <section id="about" class="block">
    <h2 class="section-title">About</h2>
    <div class="about">
      <p>I build prototypes and test them with real people. Ten years of research at startups backed by a16z, YC, and SoftBank, then interaction design at CIID, where I started working with computer vision, AI, spatial computing, and electronics. Based in Los Angeles.</p>
      <p>I studied sociology, and it still shapes how I see technology: as something people live with, not just something they use. I believe research belongs at the table before the decision, not after it. My shorthand for that is Ask. Surface. Reframe.</p>
      <p>Lately I'm drawn to calm technology, ambient interaction, and making invisible systems visible: things that notice instead of nag.</p>
    </div>
    <ul class="years">
      {years.map((y) => (
        <li><span class="when">{y.when}</span><span><strong>{y.what}</strong>{y.note && <span class="note" set:html={y.note} />}</span></li>
      ))}
    </ul>
  </section>
</Base>

<script>
  // Scroll-linked name: the big name shrinks as you scroll and lands exactly on the nav name.
  // Vertical motion is the page's own scroll; we only add scale (and a tiny x nudge).
  const name = document.querySelector('.hero-name');
  const home = document.querySelector('.nav .home');
  const nav = document.querySelector('.nav');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (name && home && nav && !reduce.matches) {
    const root = document.documentElement;
    root.classList.add('morph');
    let D = 1, r = 1, dx = 0, queued = false;
    const measure = () => {
      name.style.transform = '';
      const nr = name.getBoundingClientRect();
      const hr = home.getBoundingClientRect();
      const navTop = nav.getBoundingClientRect().top;
      const targetTop = hr.top - navTop;            // where the nav name sits once the nav is stuck at top: 0
      D = Math.max(1, nr.top + window.scrollY - targetTop);
      r = hr.height / nr.height;                     // both use line-height 1, so this is the font-size ratio
      dx = hr.left - nr.left;
      update();
    };
    const update = () => {
      queued = false;
      const p = Math.min(Math.max(window.scrollY / D, 0), 1);
      const scale = Math.pow(r, p);                  // even, perceptual shrink
      name.style.transform = `translateX(${dx * p}px) scale(${scale})`;
      root.classList.toggle('docked', p >= 1);
    };
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', measure);
    document.fonts && document.fonts.ready.then(measure);
    measure();
  }
</script>

<style>
  /* First screen: the name sits low, and the top of the first card peeks in below. */
  .intro { min-height: calc(70svh - 66px); display: flex; flex-direction: column; justify-content: flex-end; margin-bottom: 72px; }
  .status { display: inline-flex; align-items: center; gap: 8px; font: var(--meta); letter-spacing: -0.02em; color: var(--gray); margin-bottom: 20px; }
  .dot { margin-left: 3px; width: 7px; height: 7px; border-radius: 50%; background: #1E9E5A; box-shadow: 0 0 0 3px rgba(30,158,90,.15); }
  .hero-name { font: 500 clamp(56px, 12vw, 136px)/1 var(--sans); letter-spacing: -0.03em; margin: 0 0 16px; align-self: flex-start; transform-origin: 0 0; position: relative; z-index: 20; will-change: transform; }
  :global(html.morph.docked) .hero-name { visibility: hidden; }
  .intro .lead { color: var(--gray); }
  .sub { color: var(--gray); max-width: 36em; }
  .block { margin-bottom: 120px; scroll-margin-top: 24px; }
  .years { list-style: none; max-width: 760px; }
  .more { margin-top: 24px; text-align: right; font-size: 15px; }
  .block-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin-bottom: 20px; }
  .block-head .section-title { margin-bottom: 0; }
  .block-sub { color: var(--gray); font-size: 15px; }
  .about { max-width: var(--measure); margin-bottom: 40px; }
  .about p { color: var(--gray); margin-bottom: 16px; }
  .years li { display: grid; grid-template-columns: 80px 1fr; gap: 24px; padding: 12px 0; border-top: 1px solid var(--rule); }
  .when { font: var(--meta); color: var(--gray); padding-top: 3px; }
  .years strong { font: var(--label); display: block; }
  .note { display: block; color: var(--gray); font-size: 15px; }
  @media (max-width: 720px) {
    .block { margin-bottom: 80px; }
    .intro { margin-bottom: 48px; }
  }
</style>
