---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Cards from '../components/Cards.astro';
import Rows from '../components/Rows.astro';
import { experiments } from '../data/experiments';
const work = (await getCollection('work')).filter((w) => w.data.featured).sort((a, b) => a.data.order - b.data.order);

const years = [
  { when: "'25–now", what: 'Interaction designer, independent', note: 'Building physical and AI prototypes, like <a href="/work/room-tone/">room_tone</a> and <a href="/work/toilet-paper-elevator/">Toilet Paper Elevator</a>.' },
  { when: "'24–'25", what: 'Interaction Design, CIID', note: 'M.S. A year of research, build, test, repeat, prototyping across mediums.' },
  { when: "'23–'24", what: 'Senior UX Researcher, Glorify', note: 'Built the research practice and led 3 researchers. Shaped Glorify Groups (1.8M+ users).' },
  { when: "'21–'23", what: 'Design Researcher, Designit', note: 'Led research for Fortune 500 clients like Mastercard and Trane, plus <a href="/work/designit-futures/">speculative futures work</a>.' },
  { when: "'20–'21", what: 'Independent designer and researcher', note: 'Projects for Y Combinator companies like Govly, Rally.Video, and Measured.' },
  { when: "'17–'20", what: 'UX Strategist, RaiseMe', note: 'Research and strategy for a B2B2C edtech company.' },
  { when: "'15–'17", what: 'Assistant Dean of Admission, Reed College', note: 'Designed the <a href="https://www.reed.edu/admission-aid/visit/multicultural-programs/junior-scholars.html">Junior Scholars program</a> from 0 to 1 and ran the Senior Scholars program.' },
  { when: "'10–'14", what: 'B.A. Sociology, Colby College', note: '' },
];
---
<Base title="Wayne Kim, researcher who builds">
  <header class="intro">
    <p class="status"><span class="dot" aria-hidden="true"></span>Open to full-time and contract roles</p>
    <h1>Wayne Kim</h1>
    <p class="lead">Interaction designer and researcher.</p>
  </header>

  <section id="work" class="block">
    <h2 class="section-title">Selected work</h2>
    <Cards items={work} />
    <p class="more"><a href="/work/">See all work →</a></p>
  </section>

  <section id="experiments" class="block">
    <div class="block-head">
      <h2 class="section-title">Experiments</h2>
      <span class="block-sub">Shorter projects and things I was curious about.</span>
    </div>
    <Rows rows={experiments} />
    <p class="more"><a href="/experiments/">See all experiments →</a></p>
  </section>

  <section id="about" class="block">
    <h2 class="section-title">About</h2>
    <div class="about">
      <p>I'm an interaction designer and researcher. I start by understanding the context, then build a prototype, put it in front of people, and let what they do with it answer the next question.</p>
      <p>I spent ten years in research, at startups backed by a16z, YC, and SoftBank and at the design firm Designit, where I led research for Fortune 500 clients. Then I studied interaction design at CIID, where I started building with computer vision, AI, spatial computing, code, and electronics. That closed the loop: I could understand a context, build something, test it, and do it again.</p>
      <p>Lately I'm drawn to calm technology, ambient interaction, and making invisible systems visible: things that notice instead of nag.</p>
    </div>
    <ul class="years">
      {years.map((y) => (
        <li><span class="when">{y.when}</span><span><strong>{y.what}</strong>{y.note && <span class="note" set:html={y.note} />}</span></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro { margin-bottom: 120px; }
  .status { display: inline-flex; align-items: center; gap: 8px; font: var(--meta); letter-spacing: -0.02em; color: var(--gray); margin-bottom: 20px; }
  .dot { margin-left: 3px; width: 7px; height: 7px; border-radius: 50%; background: #1E9E5A; box-shadow: 0 0 0 3px rgba(30,158,90,.15); }
  .intro h1 { font-size: 32px; letter-spacing: -0.03em; margin-bottom: 12px; }
  .intro .lead { color: var(--gray); }
  .sub { color: var(--gray); max-width: 36em; }
  .block { margin-bottom: 120px; scroll-margin-top: 24px; }
  .years { list-style: none; max-width: 760px; }
  .more { margin-top: 24px; text-align: right; font-size: 15px; }
  .block-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin-bottom: 20px; }
  .block-head .section-title { margin-bottom: 0; }
  .block-sub { color: var(--gray); font-size: 15px; }
  .about { max-width: var(--measure); margin-bottom: 40px; }
  .about p { color: var(--gray); margin-bottom: 16px; }
  .years li { display: grid; grid-template-columns: 80px 1fr; gap: 24px; padding: 12px 0; border-top: 1px solid var(--rule); }
  .when { font: var(--meta); color: var(--gray); padding-top: 3px; }
  .years strong { font: var(--label); display: block; }
  .note { display: block; color: var(--gray); font-size: 15px; }
  @media (max-width: 720px) {
    .intro, .block { margin-bottom: 80px; }
  }
</style>
