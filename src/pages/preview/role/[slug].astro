---
// Preview only (not linked): "My role and contributions" as a dropdown on phones,
// and on Play pieces, the "Try it" section moved up to right after the title (in place of the hero video).
import CaseStudy from '../../../components/CaseStudy.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const all = await getCollection('work');
  return all.filter((w) => ['dear-theo', 'glorify-groups'].includes(w.id)).map((w) => ({ params: { slug: w.id }, props: { w } }));
}
const { w } = Astro.props;
const tryFirst = (w.data as any).listIn === 'experiments';
---
<CaseStudy w={w} collapseRole />
{tryFirst && (
  <style is:global>
    .cs > .hero { display: none; }
    .try-first { margin-top: 32px; }
    .try-first > h2 { font: var(--h2); margin: 0 0 16px; }
    .try-first > h2::before { content: '01'; font: var(--meta); color: var(--gray); margin-right: 14px; vertical-align: 2px; }
    .try-first figure.embed { margin-top: 0; }
  </style>
  <script is:inline>
  (() => {
    const art = document.querySelector('article.numbered'), sum = document.querySelector('.cs-sum');
    const h = art && art.querySelector(':scope > h2'); if (!h || !sum || !/try it/i.test(h.textContent)) return;
    const sec = document.createElement('article'); sec.className = 'try-first'; sec.id = h.id; h.removeAttribute('id');
    let n = h; const move = [];
    while (n) { move.push(n); n = n.nextElementSibling; if (n && n.tagName === 'H2') break; }
    move.forEach((el) => { if (el.tagName !== 'SCRIPT') sec.appendChild(el); });
    sum.prepend(sec);
    art.style.counterReset = 'sec 1';
  })();
  </script>
)}
