{
  // Cloudflare Workers serves the built site from dist/. The Worker in worker/index.js only handles /api/*
  // (the Easter egg counter); every other request goes straight to the static files.
  "name": "waynekimdesigns",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "EGG", "id": "c665946bfa88427fb69774058e76522e" }]
}
